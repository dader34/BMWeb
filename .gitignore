# Vendored data. EDIABAS/Ecu and EC-APPS are BMW proprietary and never committed.
vendor/ms45-flasher/.git/
vendor/ediabaslib-src/
vendor/BMW Standard Tools/
vendor/EDIABAS/Bin/
vendor/EDIABAS/Hardware/
vendor/**/*.bak
# .NET build output
bin/
obj/
*.user
# Node / Electron
node_modules/
node_modules
app/server-dist/

# Mac
.DS_Store

# Release builds
dist-release/
dist-web/
dist-web-test/
app/dist-release/

# Generated data: everything the tools derive from a BMW Standard Tools
# install. NONE of it is committed. The files the build and the tests read
# are published as one archive and fetched by
# scripts/setup/fetch_repo_data.py, pinned by scripts/setup/repo-data.sha256;
# the rest is rebuilt locally. (Negating inside an ignored dir needs data/*
# not data/.)
data/*
app/renderer/data/
tools/verify/fixtures/abl/
tools/verify/fixtures/ista/
# assembled per-chassis ship tree (generated by sgbd_export.py --ship)
ecus/
# Service-function catalogue: OUR OWN curated list of the service tasks a
# workshop asks for, and how to recognise the INPA key that performs each one.
# Hand-maintained source, so it is committed. The per-chassis resolution beside
# it (service-functions.chassis.json) is DERIVED from this plus data/chassis by
# tools/export/service_functions.py, so it stays ignored like the rest of the
# generated tree.
!data/service-functions.json

# Filled workflow scripts (contain large embedded ECU lists)
tools/*.filled.mjs

# Python bytecode
__pycache__/
*.pyc

# Workflow scripts (throwaway, contain absolute paths)
tools/*.mjs

# local scratch notes
/docs

# BMW originals: BUILD INPUTS, not shipped and no longer in the repo.
# 605 MB of .prg and .IPO that every generator reads and nothing at runtime
# does -- the app ships dist-web/, which is derived from them. Get them from
# BMW Standard Tools (see README) and drop them here; scripts/fetch-vendor.sh
# checks they are present.
# No trailing slash: with one these match only a real directory, and a
# SYMLINK of the same name slips straight past. Working in a git worktree
# that is exactly what you end up making -- vendor/ is gitignored so a fresh
# worktree has none of BMW's files, and linking them in from the main
# checkout is the obvious fix. Three absolute-path symlinks got committed
# that way; they point at one machine and are useless anywhere else.
vendor/EDIABAS
vendor/EC-APPS
# BMW's WDS, same deal: 259 MB of wiring documents that only the importer
# reads. scripts/setup/fetch-wds.sh installs it.
vendor/WDS
# NCS Dummy's community Translations.csv (revtor et al.): a build input for
# daten_map.py's English labels. Crowdsourced work distributed with the
# freeware, so it stays out of the repo. fetch.sh --coding installs it.
vendor/NCSDummy

# Claude Code local state: settings and 1.3GB of scratch worktrees
.claude/
tools/beta/.token.local

# Raw NCS Expert DATEN files used for local testing; never ship them
E46/

# wrangler local state for the beta collector (tools/beta)
.wrangler/
app/renderer/bundle.js

# Local test-harness only: a static file server needs the chassis archives
# where the app looks for them. Built from data/ by the packaging step in a
# real build, so it does not belong in the tree.
app/renderer/api/
