# Vendored data. EDIABAS/Ecu and EC-APPS are BMW proprietary, committed via Git LFS.
# The app only reads EDIABAS/Ecu, so the Windows Bin/Hardware are excluded.
vendor/ms45-flasher/.git/
vendor/ediabaslib-src/
vendor/BMW Standard Tools/
vendor/EDIABAS/Bin/
vendor/EDIABAS/Hardware/
vendor/**/*.bak
# .NET build output
bin/
obj/
*.user
# Node / Electron
node_modules/
app/server-dist/

# Mac
.DS_Store

# Release builds
dist-release/
dist-web/
dist-web-test/
app/dist-release/

# Derived/proprietary data: INPA-mined layouts, RE anchors tied to a flash dump,
# pasted reference lists. Generated locally from vendor data; not shipped.
# Exclude data/ contents but keep the fault-code translations (top-level DTC maps
# and per-ECU chassis subdirs). (Negating inside an ignored dir needs data/* not data/.)
data/*
# assembled per-chassis ship tree (generated by sgbd_export.py --ship)
ecus/
!data/faults/
data/faults/*
!data/faults/*.json
# Chassis config resolved from INPA's CFGDAT against the .prg tree. Committed
# because the Pages build has no running app to resolve it from, and it is
# 136 KB that only changes when BMW's config does.
!data/chassis-config/
!data/chassis-config/*.json
!data/faults/*/
!data/faults/*/*.json
# Per-ECU caption translations. These are hand-written SOURCE, not generated:
# BMW's compounds are per-ECU ("Gesteuerte LuftFuehrung GLF" is MS450's own
# wording) and a shared rule broad enough to cover them mangles other ECUs.
# tools/ipo_i18n.js resolves them into the IR.
!data/inpa-i18n/
!data/inpa-i18n/*.json
# ORT fault-code map (build input for faultindex.js: text-scheme German -> ORT
# hex per SGBD variant, dumped offline via `inpamac dumptable`). Small, shipped.
!data/ort-codes.json
# VM regression fixture: the replay corpus test_bestvm.js and test_vmbridge.js
# run against (449 KB). Committed so CI and a fresh clone can run the VM tests;
# the raw .sim captures and traces beside it stay local.
!data/sim-captures/
data/sim-captures/*
!data/sim-captures/vmfix.json
# enriched INPA screen layouts the app serves for the Status view (small, shipped)
!data/inpa-layouts/
data/inpa-layouts/*
!data/inpa-layouts/enriched/

# Filled workflow scripts (contain large embedded ECU lists)
tools/*.filled.mjs

# Python bytecode
__pycache__/
*.pyc

# Workflow scripts (throwaway, contain absolute paths)
tools/*.mjs

# Generated ECU data, committed GZIPPED ONLY (38 MB against 573 MB raw).
# The Pages build has no app and no vendor tree to regenerate from, so the
# inputs the site needs have to be in the repo. The workflow expands them;
# the .json originals stay ignored.
#
# Un-ignoring a directory re-includes EVERYTHING under it, so each rule
# re-ignores the raw .json immediately after opening the directory.
!data/job-meta/
data/job-meta/*
!data/job-meta/*.json.gz
!data/sgbd-tables/
data/sgbd-tables/*
!data/sgbd-tables/*.json.gz
!data/inpa-ir/
data/inpa-ir/*
!data/inpa-ir/*.json.gz
!data/job-code/
data/job-code/*
!data/job-code/*.json.gz
!data/job-code/index.json
# group SGBD bytecode: the variant-resolution step ships with the web build
# (same pattern as job-code -- CI has no vendor tree to regenerate from)
!data/groups/
data/groups/*
!data/groups/*.json.gz
!data/groups/variants.json
!data/groups/index.json

# local scratch notes
/docs

# BMW originals: BUILD INPUTS, not shipped and no longer in the repo.
# 605 MB of .prg and .IPO that every generator reads and nothing at runtime
# does -- the app ships dist-web/, which is derived from them. Get them from
# BMW Standard Tools (see README) and drop them here; scripts/fetch-vendor.sh
# checks they are present.
# No trailing slash: with one these match only a real directory, and a
# SYMLINK of the same name slips straight past. Working in a git worktree
# that is exactly what you end up making -- vendor/ is gitignored so a fresh
# worktree has none of BMW's files, and linking them in from the main
# checkout is the obvious fix. Three absolute-path symlinks got committed
# that way; they point at one machine and are useless anywhere else.
vendor/EDIABAS/Ecu
vendor/EC-APPS
# BMW's WDS, same deal: 259 MB of wiring documents that only the importer
# reads. scripts/setup/fetch-wds.sh installs it.
vendor/WDS
# NCS Dummy's community Translations.csv (revtor et al.): a build input for
# daten_map.py's English labels. Crowdsourced work distributed with the
# freeware, so it stays out of the repo. fetch.sh --coding installs it.
vendor/NCSDummy

# Per-car view of the generated data: data/chassis/<CHASSIS>/<ECU>/.
# Everything about one ECU in one folder, which means a shared SGBD is stored
# once per car that uses it (310 distinct -> 1022 folders). Derived, so it is
# not committed: rebuild with tools/export/build_ecu_tree.py.
data/chassis/

# ...but the DEDUPLICATED source it is built from IS committed: one copy per
# SGBD, gzipped, 32 MB. Committing the tree instead would put its 2.7x
# duplication into git permanently (252 MB).
!data/ecu-src/
data/ecu-src/*
!data/ecu-src/*.gz

# WDS wiring bundles: generated by tools/wds_import.py from a WDS release,
# the same deal as the BMW originals above. 151 MB of derived data that the
# importer reproduces in a minute, so it is a build input, not a commit.
app/renderer/data/wiring/

# Large BMW-derived fault data (ISTA/EDIABAS copyrighted text). NOT shipped in
# the repo -- hosted on Hugging Face (CraigFf/bmweb-etk/faults/) and loaded at
# runtime, with the authoritative backup in ../BMWFILES/faults-backup/. See the
# _lazyScript loader in translate.js.
app/renderer/data/faultinfo.js
app/renderer/data/faultmeta.js
app/renderer/data/faultdb.js
app/renderer/data/faultindex.js

# Claude Code local state: settings and 1.3GB of scratch worktrees
.claude/
