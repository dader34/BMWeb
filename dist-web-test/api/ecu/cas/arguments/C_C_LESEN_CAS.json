{"job":"C_C_LESEN_CAS","arguments":[{"ARG":"BINAER_BUFFER","ARGTYPE":"binary","ARGCOMMENT0":"Als Argument wird ein vorgefuellter Binaerbuffer uebergeben","ARGCOMMENT1":"Der Binaerbuffer hat folgenden Aufbau","ARGCOMMENT2":"Byte 0              : Datentyp (1:Daten, 2:Maskend)","ARGCOMMENT3":"Byte 1              : (unbenutzt) Wortbreite (1:Byte, 2:Word, 3:DWord)","ARGCOMMENT4":"Byte 2              : (unbenutzt) Byteordnung (0:LSB zuerst, 1 MSB zuerst)","ARGCOMMENT5":"Byte 3              : Adressierung (0: freie Adressierung, 1:Blockadressierung)","ARGCOMMENT6":"Byte 4              : (unbenutzt) Byteparameter 1","ARGCOMMENT7":"Byte 5,6            : (unbenutzt) WordParameter 1 (low/high)","ARGCOMMENT8":"Byte 7,8            : (unbenutzt) WordParameter 2 (low/high)","ARGCOMMENT9":"Byte 9,10,11,12     : (unbenutzt) Maske (linksbuendig)","ARGCOMMENT10":"Byte 13,14          : Anzahl Byted (low/high)","ARGCOMMENT11":"Byte 15,16          : (unbenutzt) Anzahl Wortd (low/high)","ARGCOMMENT12":"Byte 17,18,19,20    : Wortadresse (low/highbyte, low/highword)","ARGCOMMENT13":"Byte 21,....        : Codierd","ARGCOMMENT14":"Byte 21+Anzahl Daten: ETX (0x03)"}]}