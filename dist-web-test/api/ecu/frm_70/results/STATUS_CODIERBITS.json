["STAT_LIN_BEDIENTEIL : 0: kein LIN-Bedienteil codiert","STAT_LIN_SPIEGEL : 0: kein LIN-Spiegel codiert","STAT_MEMORY_SPIEGEL : 0: kein Memory-Spiegel codiert","STAT_XENON_SW : 0: kein Xenon codiert","STAT_ALC_SYSTEM : 0: kein ALC-System codiert","STAT_GURTBRINGER : 0: Gurtbringer nicht codiert","STAT_HOEHENSTANDSSENOREN_FCAN : 0: Hoehenstandssensoren ueber FCAN nicht codiert","STAT_FLC : 0: automatische Fahrlichtcontrolle nicht codiert","STAT_GETRIEBE_HANDSCHALTER : 0: Handschalter nicht codiert","STAT_SPIEGEL_HEIZUNG : 0: Spiegelheizung nicht codiert","STAT_KEINE_LWR : 0 oder 1, ob LWR aktiv","STAT_DYN_LWR : 0 oder 1, ob dynamisch LWR aktiv","STAT_AUT_LWR : 0 oder 1, ob automatische LWR aktiv","STAT_MAN_LWR : 0 oder 1, ob manuelle LWR aktiv","STAT_LWR_MIN : Kleinste Schrittmotorposition","STAT_LWR_MAX : Groesste Schrittmotorposition","STAT_LWR_SCHRITTE_REF_LAUF : Schrittanzahl fuer den Referenzlauf","JOB_STATUS : OKAY, wenn fehlerfrei","_TEL_AUFTRAG : Auftragstelegramm an SG","_TEL_ANTWORT : Hex-Antwort von SG"]