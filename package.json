{
  "name": "bmweb-renderer",
  "version": "1.1.1-beta",
  "private": true,
  "description": "BMWeb renderer",
  "scripts": {
    "build": "node scripts/build/bundle-modules.mjs && node scripts/build/bundle-renderer.mjs",
    "build:modules": "node scripts/build/bundle-modules.mjs",
    "lint": "eslint \"app/renderer/**/*.js\" \"app/renderer/**/*.mjs\" \"tools/**/*.js\" \"scripts/**/*.mjs\" \"cli/scripts/**/*.mjs\"",
    "format": "prettier --write \"app/renderer/**/*.js\" \"app/renderer/**/*.mjs\" \"tools/**/*.js\" \"scripts/**/*.mjs\" \"cli/scripts/**/*.mjs\" \"cli/src/**/*.ts\" \"cli/test/**/*.ts\"",
    "format:check": "prettier --check \"app/renderer/**/*.js\" \"app/renderer/**/*.mjs\" \"tools/**/*.js\" \"scripts/**/*.mjs\" \"cli/scripts/**/*.mjs\" \"cli/src/**/*.ts\" \"cli/test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bash tools/check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
