{
  "name": "bmweb-renderer",
  "version": "0.9.97",
  "private": true,
  "description": "BMWeb renderer",
  "scripts": {
    "build": "bash scripts/build/build-bundle.sh",
    "lint": "eslint \"app/renderer/**/*.js\" \"tools/**/*.js\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"app/renderer/**/*.js\" \"tools/**/*.js\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"app/renderer/**/*.js\" \"tools/**/*.js\" \"scripts/**/*.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bash tools/check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
